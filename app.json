{
  "expo": {
    "name": "OCFit",
    "slug": "ocfit",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "ocfit",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.orleanscrossfit.ocfit",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0a0a0a"
      },
      "package": "com.orleanscrossfit.ocfit"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow OCFit to access Face ID for secure login."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font"
    ],
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "experiments": {
      "typedRoutes": true
    },
    "newArchEnabled": true,
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7f5297a9-967f-4074-b420-76acb73da94d"
      }
    },
    "owner": "yacoub89"
  }
}
